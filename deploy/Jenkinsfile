// CD pipeline: render plain Kubernetes manifests (Deployment/) with envsubst
// and kubectl apply them. Never builds anything — it deploys an image tag
// that the CI pipeline (../Jenkinsfile) already pushed to ECR.
//
// ENVIRONMENT=dev skips the manual approval gate — the CI pipeline
// auto-triggers this job for dev on every main-branch build (see
// ../Jenkinsfile's "Trigger dev deploy" stage), so gating it on a human
// would defeat the point. Every other environment (prod) always pauses for
// approval, whether triggered by a human picking that environment here or
// (if you ever wire that up) anything else.
//
// The EKS API endpoint is private-only (see eks-poc), so this agent must
// have network access to the cluster's VPC (bastion/VPN/agent-in-VPC) —
// exactly the same constraint as the Terraform CD pipeline in eks-poc.
//
// AWS auth: static access key/secret bound via two "Secret text" Jenkins
// credentials (see the `environment` block below), same ones used by
// eks-poc's Terraform pipeline -- bound directly rather than reassigned via
// Groovy string interpolation, to avoid Jenkins' credential-masking
// warning. Needs eks:DescribeCluster for `aws eks update-kubeconfig`; the
// resulting IAM identity (jenkins-user) is already mapped to cluster-admin
// via an EKS access entry (see eks-poc's admin_principal_arns) to deploy
// into the target namespace (derived from the repo name, see NAMESPACE
// below).
//
// Helm is not used here — see ../Deployment/README.md for why the manifest
// filenames are numbered, and ../README.md for why helm/hello-world still
// exists in this repo unused.

pipeline {
    // TEMP for first test run: runs on whatever executor is available
    // (same reasoning as the CI Jenkinsfile). Swap back to
    // `agent { label 'helm-kubectl' }` once you have a dedicated agent
    // with git, awscli v2, kubectl, gettext (for envsubst), and network
    // access to the cluster's private API endpoint.
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        // Fixed dropdown rather than free-text -- a typo'd environment name
        // is a real (if small) risk, and the set of real environments is
        // small and stable enough that adding one is a deliberate,
        // one-line Jenkinsfile change, not friction. Adding an environment
        // means: add it here, add a matching Deployment/env/<name>.env, and
        // it'll deploy to cluster "eks-<name>" (see CLUSTER_NAME below).
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Environment to deploy to. Only "dev" skips the approval gate -- everything else pauses for one.'
        )
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Release version pushed by the CI pipeline, e.g. v1.2.0 (from package.json — see its image-tag.txt build artifact / build description).'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        // Derived rather than a separate param -- every cluster in
        // eks-poc's environments/tfvars/<env>.tfvars follows the
        // eks-<env> naming convention (eks-dev, eks-prod, ...).
        CLUSTER_NAME = "eks-${params.ENVIRONMENT}"
        // NAMESPACE is derived from REPO_NAME in the Checkout stage below
        // (identical to the git repo name) rather than hardcoded here.
        // Registry host is stable across all repos/apps in this account --
        // the repository name is derived from the SCM remote in the
        // Checkout stage below (matches the CI Jenkinsfile's approach).
        ECR_REGISTRY = '664874245394.dkr.ecr.ap-south-1.amazonaws.com'
        ENV_FILE     = "Deployment/env/${params.ENVIRONMENT}.env"
        RENDERED_DIR = 'Deployment/.rendered'

        // Same two "Secret text" Jenkins credentials used by eks-poc's
        // Terraform pipeline and this repo's CI Jenkinsfile. No session
        // token -- jenkins-user has long-lived static credentials, not an
        // STS-assumed role.
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
    }

    stages {
        stage('Validate parameters') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('IMAGE_TAG is required — use the tag the CI pipeline pushed (see its image-tag.txt artifact).')
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.REPO_NAME = sh(
                        script: "basename -s .git \$(git config --get remote.origin.url)",
                        returnStdout: true
                    ).trim()
                    env.ECR_REPOSITORY_URL = "${env.ECR_REGISTRY}/${env.REPO_NAME}"
                    // Namespace matches the repo/app name exactly, rather
                    // than an independently-chosen value.
                    env.NAMESPACE = env.REPO_NAME
                }
            }
        }

        stage('Verify AWS access') {
            steps {
                sh 'aws sts get-caller-identity'
            }
        }

        stage('Configure kubeconfig') {
            steps {
                sh "aws eks update-kubeconfig --region ${env.AWS_DEFAULT_REGION} --name ${env.CLUSTER_NAME}"
            }
        }

        stage('Render manifests') {
            steps {
                sh """
                    set -euo pipefail
                    rm -rf ${env.RENDERED_DIR}
                    mkdir -p ${env.RENDERED_DIR}

                    set -a
                    source ${env.ENV_FILE}
                    set +a
                    export IMAGE="${env.ECR_REPOSITORY_URL}:${params.IMAGE_TAG}"

                    for f in Deployment/0*.yaml; do
                        envsubst '\${IMAGE} \${REPLICAS} \${NAMESPACE}' < "\$f" > "${env.RENDERED_DIR}/\$(basename "\$f")"
                    done
                """
                sh "cat ${env.RENDERED_DIR}/*.yaml"
            }
        }

        stage('kubectl diff') {
            steps {
                // kubectl diff exits 1 when there ARE differences (not an
                // error) and >1 on a real failure — don't let `set -e` (or
                // Jenkins) fail the build just because there's a diff to show.
                sh "kubectl diff -f ${env.RENDERED_DIR} || true"
            }
        }

        stage('Approval') {
            // dev deploys are auto-triggered from CI and skip this gate on
            // purpose (see the header comment). Every other environment
            // always pauses here.
            when {
                expression { params.ENVIRONMENT != 'dev' }
            }
            steps {
                input message: "Deploy image tag ${params.IMAGE_TAG} to ${params.ENVIRONMENT}? Review the diff above.",
                      ok: 'Deploy'
            }
        }

        stage('kubectl apply') {
            steps {
                sh """
                    set -euo pipefail
                    kubectl apply -f ${env.RENDERED_DIR}
                    kubectl rollout status deployment/hello-world -n ${env.NAMESPACE} --timeout=5m
                """
            }
        }

        stage('Print ALB address') {
            steps {
                sh """
                    set -euo pipefail
                    echo "Waiting for the ALB hostname to be assigned..."
                    for i in \$(seq 1 30); do
                        HOST=\$(kubectl get ingress -n ${env.NAMESPACE} hello-world -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                        if [ -n "\$HOST" ]; then echo "App reachable at: http://\$HOST"; exit 0; fi
                        sleep 10
                    done
                    echo "ALB hostname not yet assigned after 5 minutes — check 'kubectl get ingress -n ${env.NAMESPACE}' manually."
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
